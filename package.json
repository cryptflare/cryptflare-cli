{
  "name": "@cryptflare/cli",
  "version": "0.9.0",
  "description": "Command-line interface for CryptFlare. Manage secrets, pods, environments, and tokens from your terminal.",
  "license": "Apache-2.0",
  "author": {
    "name": "Sacha Roussakis-Notter",
    "email": "support@cryptflare.com",
    "url": "https://cryptflare.com"
  },
  "homepage": "https://cryptflare.com/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptflare/cryptflare-cli.git"
  },
  "bugs": {
    "url": "https://github.com/cryptflare/cryptflare-cli/issues"
  },
  "keywords": [
    "cryptflare",
    "cli",
    "secrets",
    "secrets-management",
    "vault",
    "dotenv"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "cf": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cryptflare/sdk": "^1.3.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "cross-spawn": "^7.0.6",
    "open": "^11.0.0",
    "ora": "^9.3.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.19.17",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^4.1.12",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  }
}
